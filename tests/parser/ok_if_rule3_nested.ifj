// Prompt: "napis mi testy na pravidlo 3 (funkcia konci if-om) pre parser IFJ26"
// Ocakavany kod: 0 - then vetva return, else vetva konci vnorenym if/else s return v oboch vetvach
import ifj26.*

def f(): Int =
    val a = true
    val b = false
    if a then
        return 1
    else
        if b then
            return 2
        else
            return 3

@main def main(): Unit =
    val x = f()